{
  "expo": {
    "name": "Exam-Hub",
    "slug": "mobile-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Applogo.png",
    "scheme": "mobileclient",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Applogo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/Applogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.akmohanty.mobileclient",
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      "expo-av",
      "expo-file-system"
    ]
  }
}
